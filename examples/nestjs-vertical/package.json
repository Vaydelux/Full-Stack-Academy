{
  "name": "@fullstack-academy/nestjs-12-labs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "qualify": "npm run test:source-coverage && node scripts/require-lock.mjs && npm ci && npm run typecheck && npm run build && npm run test:runtime",
    "test:pipeline": "node --test tests/request-pipeline.test.mjs",
    "test:domain": "node --test tests/domain-modules.test.mjs",
    "test:advanced": "node --test tests/advanced.test.mjs",
    "test:runtime": "node --test tests/architecture.test.mjs tests/request-pipeline.test.mjs tests/domain-modules.test.mjs tests/advanced.test.mjs",
    "test:integration:pg": "node --test tests/postgres.integration.test.mjs",
    "test:integration:sockets": "node --test tests/websocket.integration.test.mjs",
    "qualify:integration": "node scripts/require-lock.mjs && npm run typecheck && npm run build && npm run test:integration:pg && npm run test:integration:sockets",
    "qualify:release": "npm run qualify && npm run qualify:integration",
    "test:source-coverage": "node scripts/verify-runtime-test-coverage.mjs --check && node --test tests/runtime-coverage-source.test.mjs && npm run test:offline",
    "test:offline:transactions": "node --experimental-strip-types --test tests/transactions.offline.test.mjs",
    "test:offline:contracts": "node --experimental-transform-types --test tests/pure-contracts.offline.test.mjs",
    "test:offline:lock": "node --test tests/lock-integrity.offline.test.mjs",
    "test:offline": "npm run test:offline:transactions && npm run test:offline:contracts && npm run test:offline:lock"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/testing": "^12.5.1",
    "@nestjs/websockets": "^12.5.1",
    "@nestjs/platform-socket.io": "^12.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10"
  }
}
