{
  "name": "@fullstack-academy/nestjs-12-labs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "qualify": "node scripts/require-lock.mjs && npm ci && npm run typecheck && npm run build && npm run test:architecture && npm run test:pipeline",
    "test:pipeline": "node --test tests/request-pipeline.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/testing": "^12.5.1",
    "@nestjs/websockets": "^12.5.1",
    "@nestjs/platform-socket.io": "^12.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^24.0.0"
  }
}
